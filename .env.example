# ===================================================
# ShopSphere — Environment Variables Configuration
# ===================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Neon PostgreSQL)
# Example: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/shopsphere?schema=public

# Direct URL for Prisma migrations if using Neon connection pooler (Optional)
DIRECT_URL=postgresql://user:password@localhost:5432/shopsphere?schema=public

# Authentication Security
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_key_min_32_chars

# Cross-Origin Resource Sharing (CORS) & CSRF Origins
CUSTOMER_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
API_ORIGIN=http://localhost:5000

# Payment Gateway Configuration
PAYMENT_PROVIDER=MOCK
PAYMENT_SECRET=mock_payment_secret_development_only

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=20
